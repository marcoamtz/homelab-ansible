#!/bin/bash
# Proxmox CT pre-start hook: block LXC boot until required NFS mounts ready.
# Without this, LXC bind mounts (mp:) capture whatever's at the host path at
# pct-start time. On Proxmox boot, pvestatd races pve-guests.service —
# bind mount can capture an empty dir, poisoning qBittorrent state with
# missingFiles flags.
# Fails the LXC start if NFS isn't ready in time, surfacing NAS-unreachable
# conditions instead of silently starting with empty mounts.
set -u
[ "${2:-}" = "pre-start" ] || exit 0

declare -A MOUNTS=(
{% for ctid, paths in lxc_pre_start_nfs_waits.items() %}
  [{{ ctid }}]="{{ paths | join(' ') }}"
{% endfor %}
)
paths="${MOUNTS[$1]:-}"
[ -z "$paths" ] && exit 0

for path in $paths; do
  for i in $(seq 1 {{ lxc_pre_start_nfs_timeout }}); do
    findmnt -t nfs,nfs4 "$path" >/dev/null 2>&1 && break
    sleep 1
  done
  if ! findmnt -t nfs,nfs4 "$path" >/dev/null 2>&1; then
    logger -t lxc-prestart -p user.err \
      "CT $1: $path not mounted after {{ lxc_pre_start_nfs_timeout }}s, aborting start"
    exit 1
  fi
done
