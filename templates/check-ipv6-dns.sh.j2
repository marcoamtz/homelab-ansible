#!/bin/bash
# Alert when the ISP router resets IPv6 DNS to "DNS agent" via TR-069.
# When correctly configured, the router's RA advertises our DNS server
# ({{ dns_server_ipv6 }}) as RDNSS. When the ISP resets via TR-069, the
# RDNSS changes to an ISP DNS server or the router itself.

LOCK_FILE="/tmp/ipv6-dns-alert-sent"

ra_output=$(/usr/bin/rdisc6 -m {{ network_interface }} 2>/dev/null)

# Extract all RDNSS addresses from RAs. When correctly configured, the router
# advertises our DNS server ({{ dns_server_ipv6 }}). When the ISP resets via
# TR-069, it changes to an ISP DNS server or the router itself.
foreign_rdnss=$(echo "$ra_output" | awk '/Recursive DNS server/{print $NF}' | grep -v "^{{ dns_server_ipv6 }}$")

if [ -n "$foreign_rdnss" ]; then
    # RDNSS changed — ISP reset DNS to "DNS agent"
    [ -f "$LOCK_FILE" ] && exit 0

    if printf "Subject: [HOMELAB] ISP reset IPv6 DNS on router\nFrom: {{ mail_from }}\nTo: {{ mail_to }}\n\nThe router is advertising a DNS server via Router Advertisement RDNSS.\nThis means the ISP reset the IPv6 DNS source from \"Static configuration\" back to \"DNS agent\".\n\nRouter RA output:\n%s\n\nFix: Log into the router and set IPv6 DNS source back to \"Static configuration\" pointing to {{ dns_server_ipv6 }}.\n\nTimestamp: $(date -Iseconds)\nHost: $(hostname)\n" "$ra_output" | /usr/bin/msmtp {{ mail_to }}; then
        touch "$LOCK_FILE"
    else
        logger -t check-ipv6-dns "Failed to send DNS alert email, will retry next run"
    fi
else
    # RDNSS is our DNS server or absent — router is correctly configured
    rm -f "$LOCK_FILE"
fi
