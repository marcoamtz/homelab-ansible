services:
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    restart: unless-stopped
    ports:
      - "{{ qbittorrent_port_webui }}:8080"
      - "{{ qbittorrent_port_torrent }}:6881"
      - "{{ qbittorrent_port_torrent }}:6881/udp"
    volumes:
      - "{{ qbittorrent_config_dir }}:/config"
      - "{{ qbittorrent_incomplete_dir }}:/downloads/incomplete"
      - "{{ qbittorrent_complete_dir }}:/downloads/complete:rslave"
    environment:
      PUID: "{{ qbittorrent_puid }}"
      PGID: "{{ qbittorrent_pgid }}"
      TZ: "{{ docker_timezone }}"
      WEBUI_PORT: "8080"
      TORRENTING_PORT: "6881"
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          curl --noproxy '*' -fsS --connect-timeout 2 --max-time 5
          "http://127.0.0.1:$${WEBUI_PORT}/" > /dev/null || exit 1
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
