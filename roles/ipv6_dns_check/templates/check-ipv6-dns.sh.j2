#!/bin/bash
# Report to an Uptime Kuma Push monitor whether the router's Router
# Advertisements list only our DNS server ({{ ipv6_dns_check_expected_rdnss }})
# as RDNSS. When the ISP resets the router's IPv6 DNS source to "DNS agent"
# via TR-069, the RDNSS changes to an ISP server or the router itself.
# Kuma alerts on status=down, on recovery, and when pushes stop arriving.
set -u

push_url="http://127.0.0.1:{{ uptime_kuma_port }}/api/push/{{ ipv6_dns_check_push_token }}"

# rdisc6 exits non-zero when no router answers.
ra_output=$(/usr/bin/rdisc6 -m {{ ipv6_dns_check_interface }} 2>/dev/null)
ra_rc=$?
rdnss=$(awk '/Recursive DNS server/{print $NF}' <<<"$ra_output" | sort -u)
foreign_rdnss=$(grep -vxF "{{ ipv6_dns_check_expected_rdnss }}" <<<"$rdnss" | paste -sd' ' -)

# No RA at all, or an RA without our RDNSS, is a failure too — otherwise a
# dead check or a router that stopped advertising DNS would report OK.
if [ "$ra_rc" -ne 0 ]; then
    status=down
    msg="No Router Advertisement received on {{ ipv6_dns_check_interface }}."
elif [ -n "$foreign_rdnss" ]; then
    status=down
    msg="Router advertises foreign IPv6 DNS: $foreign_rdnss. Set the router's IPv6 DNS source back to Static configuration ({{ ipv6_dns_check_expected_rdnss }})."
elif ! grep -qxF "{{ ipv6_dns_check_expected_rdnss }}" <<<"$rdnss"; then
    status=down
    msg="Router advertises no IPv6 DNS server. Set the router's IPv6 DNS source back to Static configuration ({{ ipv6_dns_check_expected_rdnss }})."
else
    status=up
    msg=OK
fi

curl -fsS -m 10 -o /dev/null -G \
    --data-urlencode "status=$status" --data-urlencode "msg=$msg" "$push_url" \
    || { logger -t check-ipv6-dns "Push to Uptime Kuma failed"; exit 1; }
